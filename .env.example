# NextPDF Environment Variables
# 
# NextPDF tidak memerlukan environment variables untuk berfungsi.
# Semua konfigurasi sudah ada di code.
#
# File ini hanya untuk dokumentasi jika Anda ingin menambahkan
# konfigurasi custom di masa depan.

# ============================================
# OPTIONAL CONFIGURATIONS (Future Use)
# ============================================

# Node Environment
# NODE_ENV=production

# Server Port (Next.js akan auto-detect port yang available)
# PORT=3000

# Max File Size (dikonfigurasi di next.config.ts)
# MAX_FILE_SIZE=50mb

# Rate Limit (dikonfigurasi di lib/rate-limiter.ts)
# RATE_LIMIT_MAX_REQUESTS=10
# RATE_LIMIT_WINDOW_MS=60000

# Session TTL (dikonfigurasi di lib/temp-manager.ts)
# SESSION_TTL_MS=1800000

# Cleanup Interval (dikonfigurasi di lib/cleanup-service.ts)
# CLEANUP_INTERVAL_MS=600000

# ============================================
# NOTES
# ============================================
# 
# Untuk mengubah konfigurasi, edit langsung di file berikut:
# - next.config.ts         -> File size limit
# - lib/rate-limiter.ts    -> Rate limiting
# - lib/temp-manager.ts    -> Session TTL
# - lib/cleanup-service.ts -> Cleanup interval
